{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/session-bootstrap.py"
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 .cursor/hooks/session-summary.py"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 .cursor/hooks/prompt-router.py"
      }
    ],
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/tool-guard.py"
      }
    ],
    "postToolUse": [
      {
        "command": "python3 .cursor/hooks/state-watcher.py"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "python3 .cursor/hooks/failure-router.py"
      }
    ],
    "subagentStart": [
      {
        "command": "python3 .cursor/hooks/subagent-bootstrap.py"
      }
    ],
    "subagentStop": [
      {
        "command": "python3 .cursor/hooks/subagent-summary.py"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/shell-guard.py"
      }
    ],
    "afterShellExecution": [
      {
        "command": "python3 .cursor/hooks/shell-debrief.py"
      }
    ],
    "beforeReadFile": [
      {
        "command": "python3 .cursor/hooks/read-advisor.py"
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/claim-guard.py"
      }
    ],
    "preCompact": [
      {
        "command": "python3 .cursor/hooks/compact-reminder.py"
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/stop-gate.py",
        "loop_limit": 1,
        "automatic_followup": false
      }
    ]
  }
}
