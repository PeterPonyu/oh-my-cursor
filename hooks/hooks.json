{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node --experimental-strip-types hooks/session-bootstrap.ts"
      }
    ],
    "sessionEnd": [
      {
        "command": "node --experimental-strip-types hooks/session-summary.ts"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node --experimental-strip-types hooks/prompt-router.ts"
      }
    ],
    "preToolUse": [
      {
        "command": "node --experimental-strip-types hooks/tool-guard.ts"
      }
    ],
    "postToolUse": [
      {
        "command": "node --experimental-strip-types hooks/state-watcher.ts"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node --experimental-strip-types hooks/failure-router.ts"
      }
    ],
    "subagentStart": [
      {
        "command": "node --experimental-strip-types hooks/subagent-bootstrap.ts"
      }
    ],
    "subagentStop": [
      {
        "command": "node --experimental-strip-types hooks/subagent-summary.ts"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node --experimental-strip-types hooks/shell-guard.ts"
      }
    ],
    "afterShellExecution": [
      {
        "command": "node --experimental-strip-types hooks/shell-debrief.ts"
      }
    ],
    "beforeReadFile": [
      {
        "command": "node --experimental-strip-types hooks/read-advisor.ts"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node --experimental-strip-types hooks/claim-guard.ts"
      }
    ],
    "preCompact": [
      {
        "command": "node --experimental-strip-types hooks/compact-reminder.ts"
      }
    ],
    "stop": [
      {
        "command": "node --experimental-strip-types hooks/stop-gate.ts",
        "loop_limit": 1,
        "automatic_followup": false
      }
    ]
  }
}
