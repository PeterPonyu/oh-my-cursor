{
  "name": "oh-my-cursor",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts mcp/cursor-state-bridge/tests/*.test.ts",
    "verify": "npm test && npm run e2e:structural && npm run verify:suite",
    "verify:suite": "node --experimental-strip-types scripts/verify-backbone.ts",
    "verify:fast": "./scripts/validate-fast-sanity.sh",
    "verify:full": "./scripts/validate-full-local.sh",
    "verify:e2e": "./scripts/validate-structural-e2e.sh",
    "e2e:structural": "OMCS_E2E_STRUCTURAL=1 bash scripts/local/e2e.sh",
    "e2e:headless": "OMCS_E2E_HEADLESS=1 bash scripts/local/e2e.sh",
    "e2e:real": "OMCS_E2E_REAL=1 bash scripts/local/e2e.sh"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3"
  }
}
